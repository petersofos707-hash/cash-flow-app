# Application mode:
#   demo     - fictional browser-local data, zero setup (default)
#   postgres - real data in a plain Postgres database (DATABASE_URL below),
#              auth stays the app's own signed-cookie session, no Supabase
#   supabase - Supabase Auth + Supabase Postgres
APP_DATA_MODE=demo
NEXT_PUBLIC_APP_DATA_MODE=demo
APP_URL=http://localhost:3000
APPROVED_EMAIL=owner@example.com
APP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Postgres (required when APP_DATA_MODE=postgres). Any Postgres-compatible
# database works (Timescale Cloud, Render Postgres, plain Postgres, etc).
# Apply db/migrations/*.sql once with `npm run db:migrate` before first use.
DATABASE_URL=

# Supabase (required when APP_DATA_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Basiq (optional until sandbox access is approved)
BASIQ_API_URL=https://au-api.basiq.io
BASIQ_API_VERSION=3.0
BASIQ_API_KEY=
BASIQ_WEBHOOK_SECRET=
BASIQ_ENVIRONMENT=sandbox

# Optional market-price provider adapter
MARKET_PRICE_PROVIDER=manual
MARKET_PRICE_API_KEY=

# Scheduled sync endpoint authentication
CRON_SECRET=
